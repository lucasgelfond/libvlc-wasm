From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lucas gelfond <lucasgelfond@gmail.com>
Date: Sun, 27 Sep 2026 16:22:59 +0000
Subject: [PATCH 01/12] jpeg: declare the quality option when sout is disabled

OpenEncoder() reads jpeg-quality for both submodules, but the option was only
declared in the sout encoder's submodule. Without sout var_Create() asserted on
the unknown type the first time a snapshot was encoded.
---
 modules/codec/jpeg.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/modules/codec/jpeg.c b/modules/codec/jpeg.c
index 6aa7781..377ec38 100644
--- a/modules/codec/jpeg.c
+++ b/modules/codec/jpeg.c
@@ -123,6 +123,12 @@ vlc_module_begin()
     set_description(N_("JPEG image encoder"))
     set_capability("image encoder", 1000)
     set_callback(OpenEncoder)
+#ifndef ENABLE_SOUT
+    /* OpenEncoder reads this option for both submodules; without sout it
+     * was never declared and var_Create() asserted on the unknown type. */
+    add_integer_with_range(ENC_CFG_PREFIX "quality", 95, 0, 100,
+                           ENC_QUALITY_TEXT, ENC_QUALITY_LONGTEXT)
+#endif
 vlc_module_end()
 
 
