From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lucas gelfond <lucasgelfond@gmail.com>
Date: Sun, 27 Sep 2026 18:00:00 +0000
Subject: [PATCH 15/18] avcodec: decode codecs VLC has no fourcc for

The avformat demuxer dropped any stream whose libavcodec id had no VLC
fourcc, though libavcodec could decode it: most image formats (EXR, DDS,
PSD, WebP...), game ADPCMs and screen codecs. Carry such an id as a fourcc
of its own (low byte 0x01, the id above it) and let the avcodec decoder
take it.
---
 1 file changed, 24 insertions(+), 0 deletions(-)

diff --git a/modules/codec/avcodec/fourcc.c b/modules/codec/avcodec/fourcc.c
index ab38a67..ccc08b2 100644
--- a/modules/codec/avcodec/fourcc.c
+++ b/modules/codec/avcodec/fourcc.c
@@ -549,12 +549,29 @@ static const struct vlc_avcodec_fourcc spu_codecs[] =
     /* ffmpeg only: AV_CODEC_ID_ASS */
 };
 
+/* A codec libavcodec decodes but VLC has no fourcc for travels as the
+ * libavcodec id itself: the low byte VLC_AVCODEC_ID_FOURCC, the id above it
+ * (see GetVlcFourcc). Only the avformat demuxer produces these. */
+#define VLC_AVCODEC_ID_FOURCC 0x01
+
 bool GetFfmpegCodec( const es_format_t *es,
                      enum AVCodecID *pi_ffmpeg_codec, const char **ppsz_name )
 {
     const struct vlc_avcodec_fourcc *base;
     size_t count;
 
+    if( (es->i_codec & 0xff) == VLC_AVCODEC_ID_FOURCC )
+    {
+        const AVCodecDescriptor *desc = avcodec_descriptor_get( es->i_codec >> 8 );
+        if( desc == NULL )
+            return false;
+        if( pi_ffmpeg_codec != NULL )
+            *pi_ffmpeg_codec = desc->id;
+        if( ppsz_name )
+            *ppsz_name = desc->long_name;
+        return true;
+    }
+
     if (es->i_codec == VLC_CODEC_VP8 && es_format_HasVpxAlpha(es)) // contains alpha extradata
         return false;
     if (es->i_codec == VLC_CODEC_VP9 && es_format_HasVpxAlpha(es)) // contains alpha extradata
@@ -614,5 +634,9 @@ vlc_fourcc_t GetVlcFourcc( enum AVCodecID i_ffmpeg_codec )
         if( spu_codecs[i].i_codec == i_ffmpeg_codec )
             return spu_codecs[i].i_fourcc;
     }
+    /* Not in the tables, but this libavcodec decodes it: pass the id on. */
+    if( i_ffmpeg_codec > AV_CODEC_ID_NONE && i_ffmpeg_codec < (1 << 24) &&
+        avcodec_find_decoder( i_ffmpeg_codec ) != NULL )
+        return VLC_AVCODEC_ID_FOURCC | ((vlc_fourcc_t)i_ffmpeg_codec << 8);
     return VLC_CODEC_UNKNOWN;
 }
